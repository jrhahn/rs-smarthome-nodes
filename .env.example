# Wi-Fi credentials baked into the firmware at compile time.
# Copy this file to `.env` (git-ignored) and fill in your values:
#   cp .env.example .env
# direnv then exports them automatically, so `cargo run --release` works
# without prefixing SSID=... PASSWORD=... each time.
SSID="MyNetwork"
PASSWORD="s3cret"

# Which node of the fleet this image is built for: terrasse (the outdoor
# node and the bird scale, default), schlafzimmer, wohnzimmer, kueche or bad.
# It decides the
# sensor set, the MQTT topics and the power profile — see src/node.rs. An
# unknown name fails the build. Prefer setting it per flash
# (`NODE=kueche cargo run --release`) over putting it here, so you don't flash
# the wrong personality by habit.
#NODE="terrasse"

# Optional MQTT broker credentials. Leave unset/commented for an anonymous
# broker; set them to match the broker's user (e.g. the `birdscale` Mosquitto
# user) when the broker requires authentication.
#MQTT_USER="birdscale"
#MQTT_PASSWORD="change-me"

# MQTT broker LAN address (dotted IPv4). Defaults to the current broker if
# unset. Not a secret (private RFC-1918 IP), kept here so it stays out of source.
#MQTT_BROKER="192.168.1.67"
